# Primary Vercel/Netlify PostgreSQL backend. Server-only.
DATABASE_URL=
POSTGRES_URL=

# Set these as server-side secrets. Leave blank when integrations are unused.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=
META_WORKSPACE_ID=

# Gemini free-tier (quota limited; Google free-tier data terms apply)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional approval notification: verified Resend sender required
RESEND_API_KEY=
EMAIL_FROM=
